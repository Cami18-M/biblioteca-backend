          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/transactions/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
