    },
    {
      "name": "Préstamos (Transacciones)",
      "item": [
        {
          "name": "POST /api/transactions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book\": \"{{bookId}}\"\n}"
            },
            "url": "{{base_url}}/api/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Préstamo tiene _id', function () { pm.expect(pm.response.json().data).to.have.property('_id'); });",
                  "pm.test('Estado es active', function () { pm.expect(pm.response.json().data.status).to.eql('active'); });",
                  "pm.test('Guardar transactionId', function () { pm.environment.set('transactionId', pm.response.json().data._id); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Datos es array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ],
